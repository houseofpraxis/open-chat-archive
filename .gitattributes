/archives/**/batches/**/manifest.json filter=git-crypt diff=git-crypt
/archives/**/blobs/** filter=git-crypt diff=git-crypt
/archives/**/import-manifests/** filter=git-crypt diff=git-crypt
/examples/** !filter !diff
